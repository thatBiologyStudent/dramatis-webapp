# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# Discord OAuth2 (from https://discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Your Discord User ID (enables Admin Review Queue & webhook pings)
ADMIN_DISCORD_ID=""

# Private Discord channel Webhook URL for new preset submission alerts
DISCORD_WEBHOOK_URL=""

# PostgreSQL connection string (e.g. Neon or Supabase Postgres on Vercel)
# Leave empty in local preview to use local fallback storage
DATABASE_URL=""
