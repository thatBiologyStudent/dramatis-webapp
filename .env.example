# Copy to .env for local testing. On a host, set these in its environment settings instead.
# Everything is optional: without them Dramatis runs fully, only preset publishing needs them.

# Public URL of your copy (used for the Discord sign-in redirect), e.g. https://your-app.vercel.app
APP_URL=""

# Set when the app runs under a sub-path, e.g. /tools/dramatis/
APP_BASE=""

# Discord OAuth2 (from https://discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Your Discord user ID (enables the admin review queue and webhook pings)
ADMIN_DISCORD_ID=""

# Private Discord channel webhook URL for new preset submission alerts
DISCORD_WEBHOOK_URL=""

# PostgreSQL connection string (e.g. Neon on Vercel).
# Leave empty to keep published presets in a local .data folder.
DATABASE_URL=""

# Where "Generate with Alembic" opens, and the optional back link in the header
VITE_ALEMBIC_URL=""
VITE_BACK_URL=""
VITE_BACK_LABEL=""
